+  // Take `node` out of the stack wherever it sits; false when it is not in it.
+  bool erase(T* node) {
+    for (T** link = &root; *link; link = &(*link)->nextInStack) {
+      if (*link == node) {
+        *link = node->nextInStack;
+        count--;
+        return true;
+      }
+    }
+    return false;
+  }
+
   size_t size() const { return count; }
 
